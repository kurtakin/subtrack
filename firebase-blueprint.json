{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "JPY", "CAD", "AUD", "INR", "TRY"] },
        "notificationSettings": {
          "type": "object",
          "properties": {
            "browserNotifications": { "type": "boolean" },
            "emailNotifications": { "type": "boolean" },
            "notifyDaysBefore": { "type": "number" }
          }
        }
      },
      "required": ["email"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Subscription or bill details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "nextPaymentDate": { "type": "string", "format": "date-time" },
        "icon": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "cancelled"] },
        "lastNotified": { "type": "string", "format": "date-time" },
        "pricingType": { "type": "string", "enum": ["fixed", "usage_based", "hybrid"] }
      },
      "required": ["uid", "name", "amount", "billingCycle", "nextPaymentDate"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Historical payment record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "subscriptionId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["paid", "failed", "pending"] },
        "type": { "type": "string", "enum": ["regular", "topup"] },
        "note": { "type": "string" }
      },
      "required": ["uid", "subscriptionId", "amount", "date"]
    },
    "Installment": {
      "title": "Installment",
      "description": "Installment purchase details and progress",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string" },
        "store": { "type": "string" },
        "totalAmount": { "type": "number" },
        "monthlyAmount": { "type": "number" },
        "totalInstallments": { "type": "number" },
        "paidInstallments": { "type": "number" },
        "remainingInstallments": { "type": "number" },
        "startDate": { "type": "string" },
        "nextPaymentDate": { "type": "string" },
        "category": { "type": "string" },
        "bankOrCard": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "note": { "type": "string" },
        "isAutoPayment": { "type": "boolean" },
        "calendarEventId": { "type": "string" },
        "calendarEventIds": { "type": "array" },
        "calendarSyncedAt": { "type": "string" },
        "lastPaidDate": { "type": "string" },
        "lastPaidMonth": { "type": "string" },
        "lastPaidInstallmentNumber": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "totalAmount", "monthlyAmount", "totalInstallments", "nextPaymentDate"]
    },
    "RegularPayment": {
      "title": "RegularPayment",
      "description": "Monthly recurring or irregular bills and payments (rent, electricity, water, gas, phone, persons)",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "payee": { "type": "string" },
        "amount": { "type": "number" },
        "amountType": { "type": "string", "enum": ["fixed", "variable"] },
        "frequency": { "type": "string", "enum": ["monthly", "irregular", "bimonthly", "quarterly", "annual"] },
        "dueDay": { "type": "number" },
        "nextPaymentDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "cancelled"] },
        "isAutoPayment": { "type": "boolean" },
        "bankOrCard": { "type": "string" },
        "accountOrSubscriberNo": { "type": "string" },
        "note": { "type": "string" },
        "lastPaidDate": { "type": "string" },
        "lastPaidMonth": { "type": "string" },
        "calendarEventId": { "type": "string" },
        "calendarSyncedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "amount", "category", "nextPaymentDate"]
    },
    "IncomeItem": {
      "title": "IncomeItem",
      "description": "User income sources",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "frequency": { "type": "string", "enum": ["monthly", "biweekly", "irregular", "annual"] },
        "receivedDay": { "type": "number" },
        "isRegular": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "paused"] },
        "note": { "type": "string" }
      },
      "required": ["uid", "name", "amount", "category"]
    },
    "SavingsTarget": {
      "title": "SavingsTarget",
      "description": "User savings goals and target funds",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "monthlyContribution": { "type": "number" },
        "deadline": { "type": "string" },
        "category": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["uid", "title", "targetAmount", "currentAmount"]
    },
    "TaxProfile": {
      "title": "TaxProfile",
      "description": "User tax estimates and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner user ID" },
        "country": { "type": "string" },
        "taxYear": { "type": "number" },
        "expectedAnnualTaxRefund": { "type": "number" },
        "actualReceivedTaxRefund": { "type": "number" },
        "estimatedAnnualTaxPayable": { "type": "number" },
        "deductibleExpensesEstimate": { "type": "number" },
        "taxPeriodReminderNote": { "type": "string" }
      },
      "required": ["uid", "country", "taxYear"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/subscriptions/{subId}": {
      "schema": "Subscription",
      "description": "Subscription documents"
    },
    "/subscriptions/{subId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment history for a subscription"
    },
    "/installments/{instId}": {
      "schema": "Installment",
      "description": "User installment purchase documents"
    },
    "/regularPayments/{paymentId}": {
      "schema": "RegularPayment",
      "description": "Monthly regular and irregular payment documents"
    },
    "/incomes/{incId}": {
      "schema": "IncomeItem",
      "description": "User income documents"
    },
    "/savings/{savId}": {
      "schema": "SavingsTarget",
      "description": "User savings target documents"
    },
    "/taxProfiles/{taxId}": {
      "schema": "TaxProfile",
      "description": "User tax profile documents"
    }
  }
}
